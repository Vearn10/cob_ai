<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>R.Y.E. Core Terminal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Rajdhani', 'sans-serif'],
                        hud: ['Orbitron', 'sans-serif'],
                    },
                    colors: {
                        rye: {
                            blue: '#00f0ff',
                            dark: '#030712',
                            card: '#0a1220',
                            border: '#00f0ff33',
                            glow: 'rgba(0, 240, 255, 0.15)'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .hud-border {
            border: 1px solid rgba(0, 240, 255, 0.25);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.08), inset 0 0 15px rgba(0, 240, 255, 0.05);
        }

        .hud-glow-text {
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
        }

        .arc-reactor-spin {
            animation: spin 12s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .scanline {
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0) 50%, rgba(0, 240, 255, 0.03) 50%, rgba(0, 240, 255, 0.03));
            background-size: 100% 4px;
        }
    </style>
</head>

<body
    class="bg-slate-950 text-cyan-100 h-full flex flex-col font-sans antialiased scanline selection:bg-cyan-500/30 selection:text-cyan-200">

    <!-- Top HUD Header -->
    <header
        class="h-20 border-b border-cyan-500/30 bg-slate-950/90 backdrop-blur-md sticky top-0 z-50 flex items-center justify-between px-4 sm:px-8">

        <!-- Custom Avatar/Logo Section -->
        <div class="flex items-center gap-4">
            <div class="relative group cursor-pointer" onclick="document.getElementById('logoUploader').click()">
                <div
                    class="absolute -inset-1 bg-cyan-500/20 rounded-full blur sm:group-hover:bg-cyan-500/40 transition">
                </div>
                <div
                    class="relative w-12 h-12 rounded-full border border-cyan-400/60 bg-slate-900 flex items-center justify-center overflow-hidden shadow-lg shadow-cyan-500/20">
                    <img id="customLogo" src="" alt="Core" class="w-full h-full object-cover hidden">
                    <div id="defaultArc"
                        class="w-8 h-8 rounded-full border-2 border-dashed border-cyan-400 arc-reactor-spin flex items-center justify-center">
                        <div class="w-3 h-3 rounded-full bg-cyan-400 shadow-[0_0_8px_#00f0ff]"></div>
                    </div>
                </div>
                <div
                    class="absolute -bottom-1 -right-1 bg-cyan-950 border border-cyan-400 text-[9px] font-hud px-1 rounded text-cyan-300">
                    EDIT
                </div>
            </div>
            <input type="file" id="logoUploader" accept="image/*" class="hidden" onchange="loadCustomLogo(event)">

            <div>
                <h1
                    class="text-lg font-hud font-extrabold tracking-wider text-cyan-400 hud-glow-text flex items-center gap-2">
                    R.Y.E.
                    <span
                        class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-hud bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 tracking-normal">
                        RYE XVIV
                    </span>
                </h1>
                <p class="text-xs text-cyan-500/70 font-mono uppercase tracking-widest">Responsive Yield Engine</p>
            </div>
        </div>

        <!-- Controls HUD -->
        <div class="flex items-center gap-3">
            <!-- Voice Mute Toggle -->
            <button id="voiceToggleBtn" onclick="toggleVoice()"
                class="bg-slate-900 text-xs font-hud text-cyan-400 px-3 py-2 rounded border border-cyan-500/40 hover:bg-cyan-950 transition flex items-center gap-1.5">
                <span id="voiceIcon">🔊</span> <span id="voiceStatus">VOICE ON</span>
            </button>

            <div class="relative">
                <select id="modelSelect"
                    class="appearance-none bg-slate-900/90 text-xs font-hud text-cyan-300 pl-3 pr-8 py-2 rounded border border-cyan-500/40 focus:outline-none focus:border-cyan-400 transition">
                    <option value="openai/gpt-oss-120b">NEURAL-120B (High Precision)</option>
                    <option value="openai/gpt-oss-20b">NEURAL-20B (Rapid)</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-cyan-400">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
            </div>

            <input type="password" id="apiKeyInput" placeholder="ACCESS KEY (gsk_...)"
                class="bg-slate-900/90 text-xs text-cyan-200 placeholder-cyan-700/60 font-mono px-3 py-2 rounded border border-cyan-500/40 w-36 sm:w-48 focus:outline-none focus:border-cyan-400 transition">
        </div>
    </header>

    <!-- Main Workspace / Chat Console -->
    <main class="flex-1 overflow-hidden relative flex flex-col max-w-5xl w-full mx-auto p-4">
        <div id="chatLog" class="flex-1 overflow-y-auto p-4 space-y-6 scrollbar-thin scrollbar-thumb-cyan-900">

            <!-- System Welcome Module -->
            <div class="hud-border bg-slate-900/40 rounded-lg p-4 flex gap-4 items-start backdrop-blur-md">
                <div class="p-2 bg-cyan-500/10 text-cyan-400 rounded border border-cyan-500/30 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="space-y-1">
                    <h2 class="font-hud text-sm font-bold text-cyan-300 tracking-wider">R.Y.E. VOICE SYNTHESIS
                        INITIALIZED</h2>
                    <p class="text-xs text-cyan-200/70 leading-relaxed font-sans">
                        Greetings, Boss. <strong class="text-cyan-400">R.Y.E.</strong> voice module updated: female
                        audio profile active set to 1.25x speed. Long responses will be auto-summarized prior to
                        playback.
                    </p>
                </div>
            </div>

        </div>
    </main>

    <!-- HUD Input Command Console -->
    <footer class="border-t border-cyan-500/30 bg-slate-950/95 backdrop-blur-md p-4 sm:p-6">
        <div class="max-w-5xl mx-auto space-y-3">
            <div class="relative flex items-center">
                <input type="text" id="userInput" placeholder="Enter directive or visualization query..."
                    class="w-full bg-slate-900/90 border border-cyan-500/40 rounded-lg pl-4 pr-32 py-3 text-sm text-cyan-100 placeholder-cyan-700 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 font-sans transition">
                <button onclick="sendChatMessage()"
                    class="absolute right-1.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-hud font-bold px-4 py-1.5 rounded text-xs transition shadow-[0_0_10px_rgba(0,240,255,0.4)] flex items-center gap-1">
                    <span>EXECUTE</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>

            <!-- Visual & Command Options -->
            <div class="flex items-center gap-3 pt-1">
                <button onclick="generatePicture()"
                    class="bg-slate-900 hover:bg-cyan-950 text-cyan-400 border border-cyan-500/40 px-3 py-1.5 rounded text-xs font-hud font-semibold flex items-center gap-2 transition shadow-sm">
                    <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                        </path>
                    </svg>
                    <span>RENDER VISUAL</span>
                </button>
                <button onclick="insertSample('What is the 4th letter in the alphabet?')"
                    class="bg-slate-900 hover:bg-slate-800 text-cyan-500/80 hover:text-cyan-300 border border-slate-800 px-3 py-1.5 rounded text-xs font-hud transition flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    <span>DIAGNOSTIC TEST</span>
                </button>
            </div>
        </div>
    </footer>

    <script>
        const customLogoImg = document.getElementById('customLogo');
        const defaultArc = document.getElementById('defaultArc');

        const savedLogo = localStorage.getItem('rye_custom_logo');
        if (savedLogo) {
            customLogoImg.src = savedLogo;
            customLogoImg.classList.remove('hidden');
            defaultArc.classList.add('hidden');
        }

        function loadCustomLogo(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const base64Img = e.target.result;
                    customLogoImg.src = base64Img;
                    customLogoImg.classList.remove('hidden');
                    defaultArc.classList.add('hidden');
                    localStorage.setItem('rye_custom_logo', base64Img);
                };
                reader.readAsDataURL(file);
            }
        }

        const apiKeyInput = document.getElementById('apiKeyInput');
        apiKeyInput.value = localStorage.getItem('groq_key') || '';
        apiKeyInput.addEventListener('input', (e) => {
            localStorage.setItem('groq_key', e.target.value.trim());
        });

        document.getElementById('userInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                sendChatMessage();
            }
        });

        const chatLog = document.getElementById('chatLog');

        // --- Voice Synthesis Subsystem ---
        let voiceEnabled = true;

        function toggleVoice() {
            voiceEnabled = !voiceEnabled;
            document.getElementById('voiceIcon').textContent = voiceEnabled ? '🔊' : '🔇';
            document.getElementById('voiceStatus').textContent = voiceEnabled ? 'VOICE ON' : 'VOICE OFF';
            if (!voiceEnabled) {
                window.speechSynthesis.cancel();
            }
        }

        function speakText(text) {
            if (!voiceEnabled || !('speechSynthesis' in window)) return;

            window.speechSynthesis.cancel(); // Stop any active speech

            // Strip HTML tags and code blocks for clean voice output
            let cleanText = text.replace(/<[^>]*>?/gm, '').replace(/```[\s\S]*?```/g, 'Code block generated.');

            // Summarize if text is long (> 300 characters)
            if (cleanText.length > 300) {
                const sentences = cleanText.match(/[^.!?]+[.!?]+/g) || [cleanText];
                // Take the first 2 key sentences as summary
                cleanText = "Summary: " + sentences.slice(0, 2).join(' ');
            }

            const utterance = new SpeechSynthesisUtterance(cleanText);
            utterance.rate = 1.25; // Speed set to 1.25x (+25% faster)
            utterance.pitch = 1.1; // Slightly higher pitch for female voice tone

            // Select a female voice profile dynamically
            const voices = window.speechSynthesis.getVoices();
            const femaleVoice = voices.find(v =>
                v.lang.startsWith('en') && (
                    v.name.toLowerCase().includes('female') ||
                    v.name.toLowerCase().includes('zira') ||
                    v.name.toLowerCase().includes('samantha') ||
                    v.name.toLowerCase().includes('victoria') ||
                    v.name.toLowerCase().includes('karen') ||
                    v.name.toLowerCase().includes('google uk english female') ||
                    v.name.toLowerCase().includes('google us english')
                )
            ) || voices.find(v => v.lang.startsWith('en'));

            if (femaleVoice) {
                utterance.voice = femaleVoice;
            }

            window.speechSynthesis.speak(utterance);
        }

        // Ensure voice list is pre-loaded by browser
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => {
                window.speechSynthesis.getVoices();
            };
        }

        function appendMessage(role, content, isError = false) {
            const msgContainer = document.createElement('div');
            msgContainer.className = `flex gap-3 max-w-4xl ${role === 'USER' ? 'ml-auto flex-row-reverse' : ''}`;

            const avatarSrc = localStorage.getItem('rye_custom_logo');

            if (role === 'USER') {
                msgContainer.innerHTML = `
                    <div class="h-8 w-8 rounded border border-cyan-500/50 bg-slate-900 flex items-center justify-center shrink-0 font-hud text-[10px] font-bold text-cyan-400">
                        USER
                    </div>
                    <div class="p-3.5 rounded-lg bg-cyan-950/40 border border-cyan-500/30 text-cyan-100 text-sm leading-relaxed max-w-2xl">
                        ${escapeHtml(content)}
                    </div>
                `;
            } else if (isError) {
                msgContainer.innerHTML = `
                    <div class="h-8 w-8 rounded border border-rose-500/60 bg-rose-950 flex items-center justify-center shrink-0 font-hud text-[10px] font-bold text-rose-400">
                        ERR
                    </div>
                    <div class="p-3.5 rounded-lg bg-rose-950/30 border border-rose-500/40 text-rose-300 text-sm leading-relaxed max-w-2xl">
                        <strong class="font-hud text-xs tracking-wider block mb-1 text-rose-400">CRITICAL ERROR</strong>
                        ${escapeHtml(content)}
                    </div>
                `;
                speakText(`Error: ${content}`);
            } else {
                const logoHtml = avatarSrc
                    ? `<img src="${avatarSrc}" class="w-full h-full object-cover">`
                    : `<span class="font-hud text-[10px] font-bold text-cyan-400">RYE</span>`;

                msgContainer.innerHTML = `
                    <div class="h-8 w-8 rounded border border-cyan-400/60 bg-slate-900 flex items-center justify-center shrink-0 overflow-hidden shadow-[0_0_8px_rgba(0,240,255,0.3)]">
                        ${logoHtml}
                    </div>
                    <div class="hud-border p-3.5 rounded-lg bg-slate-900/80 text-cyan-100 text-sm leading-relaxed max-w-3xl space-y-2">
                        ${content}
                    </div>
                `;
                speakText(content);
            }

            chatLog.appendChild(msgContainer);
            chatLog.scrollTop = chatLog.scrollHeight;
        }

        function escapeHtml(str) {
            return str.replace(/[&<>"']/g, (m) => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            })[m]);
        }

        async function sendChatMessage() {
            const promptInput = document.getElementById('userInput');
            const promptText = promptInput.value.trim();
            const apiKey = apiKeyInput.value.trim();
            const selectedModel = document.getElementById('modelSelect').value;

            if (!promptText) return;
            if (!apiKey) {
                appendMessage('SYSTEM', 'Access Denied: Groq API Key required.', true);
                return;
            }

            appendMessage('USER', promptText);
            promptInput.value = '';

            const loadingId = 'loading-' + Date.now();
            const loadingDiv = document.createElement('div');
            loadingDiv.id = loadingId;
            loadingDiv.className = 'flex gap-3 max-w-4xl';
            loadingDiv.innerHTML = `
                <div class="h-8 w-8 rounded border border-cyan-400/60 bg-slate-900 flex items-center justify-center shrink-0 font-hud text-[10px] font-bold text-cyan-400">
                    RYE
                </div>
                <div class="p-3.5 rounded-lg bg-slate-900/80 border border-cyan-500/30 text-cyan-400 text-xs font-hud flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                    PROCESSING DATA DIRECTIVE...
                </div>
            `;
            chatLog.appendChild(loadingDiv);
            chatLog.scrollTop = chatLog.scrollHeight;

            try {
                const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        model: selectedModel,
                        messages: [{ role: 'user', content: promptText }]
                    })
                });

                const data = await response.json();
                document.getElementById(loadingId)?.remove();

                if (!response.ok) {
                    throw new Error(data.error?.message || 'Groq API core failure.');
                }

                const aiResponse = data.choices[0]?.message?.content || 'No output stream returned.';
                appendMessage('AI', escapeHtml(aiResponse).replace(/\n/g, '<br>'));
            } catch (err) {
                document.getElementById(loadingId)?.remove();
                appendMessage('SYSTEM', err.message, true);
            }
        }

        function generatePicture() {
            const promptInput = document.getElementById('userInput');
            const promptText = promptInput.value.trim();

            if (!promptText) {
                alert('Specify visualization prompt in command line.');
                return;
            }

            appendMessage('USER', `[VISUALIZE]: ${promptText}`);
            promptInput.value = '';

            const imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(promptText)}?width=1024&height=1024&nologo=true`;

            const imgWrapper = document.createElement('div');
            imgWrapper.className = 'space-y-2';

            const statusText = document.createElement('p');
            statusText.className = 'text-xs text-cyan-400 font-hud animate-pulse';
            statusText.textContent = `Rendering visual matrix for: "${promptText}"...`;

            const img = document.createElement('img');
            img.src = imageUrl;
            img.alt = promptText;
            img.className = 'rounded border border-cyan-500/40 bg-slate-950 max-w-md w-full shadow-[0_0_15px_rgba(0,240,255,0.2)] object-cover';
            img.onload = () => statusText.remove();
            img.onerror = () => {
                imgWrapper.innerHTML = '<p class="text-rose-400 text-xs font-hud">VISUAL RENDER FAILED.</p>';
            };

            imgWrapper.appendChild(statusText);
            imgWrapper.appendChild(img);

            const avatarSrc = localStorage.getItem('rye_custom_logo');
            const logoHtml = avatarSrc
                ? `<img src="${avatarSrc}" class="w-full h-full object-cover">`
                : `<span class="font-hud text-[10px] font-bold text-cyan-400">RYE</span>`;

            const msgContainer = document.createElement('div');
            msgContainer.className = 'flex gap-3 max-w-4xl';
            msgContainer.innerHTML = `
                <div class="h-8 w-8 rounded border border-cyan-400/60 bg-slate-900 flex items-center justify-center shrink-0 overflow-hidden shadow-[0_0_8px_rgba(0,240,255,0.3)]">
                    ${logoHtml}
                </div>
                <div class="hud-border p-3.5 rounded-lg bg-slate-900/80 text-cyan-100 text-sm">
                </div>
            `;
            msgContainer.querySelector('.hud-border').appendChild(imgWrapper);

            chatLog.appendChild(msgContainer);
            chatLog.scrollTop = chatLog.scrollHeight;

            speakText(`Rendering visual matrix for ${promptText}`);
        }

        function insertSample(text) {
            document.getElementById('userInput').value = text;
        }
    </script>
</body>

</html>
